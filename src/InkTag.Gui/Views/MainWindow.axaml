<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:InkTag.Gui.ViewModels"
        xmlns:conv="using:InkTag.Gui.Converters"
        xmlns:controls="using:InkTag.Gui.Controls"
        x:Class="InkTag.Gui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="InkTag Desktop"
        Icon="/Assets/inktag.ico"
        Width="1200" Height="750"
        MinWidth="950" MinHeight="550"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">

  <Window.Resources>
    <conv:IsDirtyToBrushConverter x:Key="IsDirtyToBrushConverter"/>
  </Window.Resources>

  <Window.KeyBindings>
    <KeyBinding Gesture="{OnPlatform 'Ctrl+S', macOS='Cmd+S'}" Command="{Binding SaveAllCommand}"/>
    <KeyBinding Gesture="{OnPlatform 'Ctrl+A', macOS='Cmd+A'}" Command="{Binding SelectAllCommand}"/>
  </Window.KeyBindings>

  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="File">
        <NativeMenu>
          <NativeMenuItem Header="Open Folder..." Gesture="{OnPlatform 'Ctrl+O', macOS='Cmd+O'}" Click="NativeOpenFolder_Click"/>
          <NativeMenuItem Header="Save All" Gesture="{OnPlatform 'Ctrl+S', macOS='Cmd+S'}" Click="NativeSaveAll_Click"/>
          <NativeMenuItem Header="Export CSV..." Click="NativeExportCsv_Click"/>
          <NativeMenuItemSeparator/>
          <NativeMenuItem Header="Exit" Gesture="{OnPlatform 'Ctrl+Q', macOS='Cmd+Q'}" Click="NativeExit_Click"/>
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="Edit">
        <NativeMenu>
          <NativeMenuItem Header="Select All" Gesture="{OnPlatform 'Ctrl+A', macOS='Cmd+A'}" Click="NativeSelectAll_Click"/>
          <NativeMenuItem Header="Clear Selection" Click="NativeClearSelection_Click"/>
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="View">
        <NativeMenu>
          <NativeMenuItem Header="Overview Dashboard" ToggleType="Radio" IsChecked="{Binding IsOverviewView}" Click="NativeShowOverview_Click"/>
          <NativeMenuItem Header="Library Grid" ToggleType="Radio" IsChecked="{Binding IsSpreadsheetView}" Click="NativeShowSpreadsheet_Click"/>
          <NativeMenuItemSeparator/>
          <NativeMenuItem Header="Scan Recursively" ToggleType="CheckBox" IsChecked="{Binding IsRecursive}"/>
          <NativeMenuItem Header="Library Rail" ToggleType="CheckBox" IsChecked="{Binding IsRailVisible}"/>
          <NativeMenuItem Header="Inspector Panel" ToggleType="CheckBox" IsChecked="{Binding IsInspectorVisible}"/>
          <NativeMenuItemSeparator/>
          <NativeMenuItem Header="Theme">
            <NativeMenu>
              <NativeMenuItem Header="System Default" ToggleType="Radio" IsChecked="{Binding IsThemeSystem}" Click="NativeThemeSystem_Click"/>
              <NativeMenuItem Header="Dark Mode" ToggleType="Radio" IsChecked="{Binding IsThemeDark}" Click="NativeThemeDark_Click"/>
              <NativeMenuItem Header="Light Mode" ToggleType="Radio" IsChecked="{Binding IsThemeLight}" Click="NativeThemeLight_Click"/>
            </NativeMenu>
          </NativeMenuItem>
          <NativeMenuItemSeparator/>
          <NativeMenuItem Header="Enable Verbose / Debug Logging" ToggleType="CheckBox" Click="NativeToggleDebugLogging_Click"/>
          <NativeMenuItemSeparator/>
          <NativeMenuItem Header="Refresh Grid" Gesture="{OnPlatform 'F5', macOS='Cmd+R'}" Click="NativeRefreshGrid_Click"/>
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="Tools">
        <NativeMenu>
          <NativeMenuItem Header="Auto-Tag Metadata (ComicVine)..." Click="NativeScrapeMetadata_Click"/>
          <NativeMenuItem Header="Series Search Wizard..." Click="NativeSeriesSearchWizard_Click"/>
          <NativeMenuItem Header="Bulk Auto-Tag Queue..." Click="NativeBulkScrapeQueue_Click"/>
          <NativeMenuItem Header="Infer Metadata from Path / Filename" Click="NativeInferMetadataFromFilenames_Click"/>
          <NativeMenuItem Header="Rename File(s) from Metadata..." Click="NativeRenameFiles_Click"/>
          <NativeMenuItemSeparator/>
          <NativeMenuItem Header="Sync to Komga Server" Click="NativeSyncToKomga_Click"/>
          <NativeMenuItemSeparator/>
          <NativeMenuItem Header="Open Logs Directory" Click="NativeOpenLogs_Click"/>
          <NativeMenuItem Header="Settings..." Gesture="{OnPlatform 'Ctrl+,', macOS='Cmd+,'}" Click="NativeSettings_Click"/>
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="Help">
        <NativeMenu>
          <NativeMenuItem Header="Check for Updates" Click="NativeCheckForUpdates_Click"/>
          <NativeMenuItem Header="Install &amp; Restart Update" Command="{Binding ApplyUpdateCommand}" IsVisible="{Binding IsUpdateAvailable}"/>
          <NativeMenuItemSeparator/>
          <NativeMenuItem Header="About InkTag Desktop" Click="NativeAbout_Click"/>
        </NativeMenu>
      </NativeMenuItem>
    </NativeMenu>
  </NativeMenu.Menu>

  <Grid RowDefinitions="Auto, Auto, Auto, *, Auto">
    
    <!-- Top MenuBar (Hidden on macOS so only the system macOS menu bar is used) -->
    <Menu Grid.Row="0" IsVisible="{OnPlatform macOS=False, Default=True}" Background="{DynamicResource AppHeaderBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
      <!-- File Menu -->
      <MenuItem Header="_File">
        <MenuItem Header="_Open Folder..." InputGesture="Ctrl+O" Click="OpenFolder_Click"/>
        <MenuItem Header="_Save All" InputGesture="Ctrl+S" Command="{Binding SaveAllCommand}"/>
        <MenuItem Header="_Export CSV..." Click="ExportCsv_Click"/>
        <Separator/>
        <MenuItem Header="E_xit" InputGesture="Ctrl+Q" Click="Exit_Click"/>
      </MenuItem>

      <!-- Edit Menu -->
      <MenuItem Header="_Edit">
        <MenuItem Header="Select _All" InputGesture="Ctrl+A" Click="SelectAll_Click"/>
        <MenuItem Header="_Clear Selection" Click="ClearSelection_Click"/>
      </MenuItem>

      <!-- View Menu -->
      <MenuItem Header="_View">
        <MenuItem Header="📊 _Overview Dashboard" Command="{Binding ShowOverviewViewCommand}"/>
        <MenuItem Header="📑 Library _Grid" Command="{Binding ShowSpreadsheetViewCommand}"/>
        <Separator/>
        <MenuItem Header="Scan _Recursively">
          <MenuItem.Icon>
            <CheckBox IsChecked="{Binding IsRecursive}" VerticalAlignment="Center"/>
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Library _Rail" Command="{Binding ToggleRailCommand}">
          <MenuItem.Icon>
            <CheckBox IsChecked="{Binding IsRailVisible}" VerticalAlignment="Center"/>
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="_Inspector Panel" Command="{Binding ToggleInspectorCommand}">
          <MenuItem.Icon>
            <CheckBox IsChecked="{Binding IsInspectorVisible}" VerticalAlignment="Center"/>
          </MenuItem.Icon>
        </MenuItem>
        <Separator/>
        <MenuItem Header="_Theme">
          <MenuItem Header="_System Default" Click="ThemeSystem_Click">
            <MenuItem.Icon>
              <RadioButton IsChecked="{Binding IsThemeSystem}" IsHitTestVisible="False" VerticalAlignment="Center"/>
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="_Dark Mode" Click="ThemeDark_Click">
            <MenuItem.Icon>
              <RadioButton IsChecked="{Binding IsThemeDark}" IsHitTestVisible="False" VerticalAlignment="Center"/>
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="_Light Mode" Click="ThemeLight_Click">
            <MenuItem.Icon>
              <RadioButton IsChecked="{Binding IsThemeLight}" IsHitTestVisible="False" VerticalAlignment="Center"/>
            </MenuItem.Icon>
          </MenuItem>
        </MenuItem>
        <Separator/>
        <MenuItem Header="Enable _Verbose / Debug Logging" Click="ToggleDebugLogging_Click">
          <MenuItem.Icon>
            <CheckBox Name="DebugLoggingMenuCheckBox" Click="ToggleDebugLogging_Click" VerticalAlignment="Center"/>
          </MenuItem.Icon>
        </MenuItem>
        <Separator/>
        <MenuItem Header="_Refresh Grid" InputGesture="F5" Command="{Binding RefreshGridCommand}"/>
      </MenuItem>

      <!-- Tools Menu -->
      <MenuItem Header="_Tools">
        <MenuItem Header="🔍 _Auto-Tag Metadata (ComicVine)..." Click="ScrapeMetadata_Click" IsEnabled="{Binding CanAutoTagSingle}"/>
        <MenuItem Header="🧙 Series _Search Wizard..." Click="SeriesSearchWizard_Click" IsEnabled="{Binding CanAutoTagSingle}"/>
        <MenuItem Header="📚 _Bulk Auto-Tag Queue..." Click="BulkScrapeQueue_Click"/>
        <MenuItem Header="🏷️ _Infer Metadata from Path / Filename" Click="InferMetadataFromFilenames_Click"/>
        <MenuItem Header="✏️ _Rename File(s) from Metadata..." Click="RenameFiles_Click"/>
        <Separator/>
        <MenuItem Header="🌐 _Sync to Komga Server" Command="{Binding SyncToKomgaCommand}"/>
        <Separator/>
        <MenuItem Header="Open _Logs Directory" Command="{Binding OpenLogsCommand}"/>
        <MenuItem Header="_Settings..." Click="Settings_Click"/>
      </MenuItem>
      
      <!-- Help Menu -->
      <MenuItem Header="_Help">
        <MenuItem Header="_Check for Updates" Command="{Binding CheckForUpdatesCommand}"/>
        <MenuItem Header="Install &amp; Restart Update" Command="{Binding ApplyUpdateCommand}" IsVisible="{Binding IsUpdateAvailable}"/>
        <Separator/>
        <MenuItem Header="_About InkTag Desktop" Click="OpenAbout_Click"/>
      </MenuItem>
    </Menu>

    <!-- Top Header Toolbar -->
    <Border Grid.Row="1" Background="{DynamicResource AppToolbarBrush}" Padding="8,6" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto, Auto, Auto, Auto, *, Auto">
        <!-- Open Folder Button (Primary Call-to-Action) -->
        <Button Grid.Column="0" Click="OpenFolder_Click" Padding="14,6" Background="{DynamicResource AppAccentBrush}" Foreground="{DynamicResource AppAccentForegroundBrush}" CornerRadius="4" IsEnabled="{Binding !IsLoading}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="📁" VerticalAlignment="Center"/>
            <TextBlock Text="Open Folder..." VerticalAlignment="Center" FontWeight="SemiBold"/>
          </StackPanel>
        </Button>

        <!-- Save All Button (Neutral Outline) -->
        <Button Grid.Column="1" Classes="outline" Command="{Binding SaveAllCommand}" Margin="8,0,0,0" IsEnabled="{Binding !IsLoading}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="💾" VerticalAlignment="Center"/>
            <TextBlock Text="Save All" VerticalAlignment="Center" FontWeight="Medium"/>
          </StackPanel>
        </Button>

        <!-- Separator -->
        <Rectangle Grid.Column="2" Width="1" Fill="{DynamicResource AppBorderBrush}" Margin="12,3"/>

        <!-- Scan Recursively CheckBox Toggle -->
        <CheckBox Grid.Column="3" IsChecked="{Binding IsRecursive}" Content="Scan Subfolders Recursively" VerticalAlignment="Center" Margin="0,0,12,0" IsEnabled="{Binding !IsLoading}"/>

        <!-- Right Side Controls: Scrape, Refresh & Inspector Toggle (Neutral Outline Utilities) -->
        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8">
          <Button Classes="outline" Click="ScrapeMetadata_Click" ToolTip.Tip="{Binding AutoTagButtonTooltip}" IsEnabled="{Binding CanAutoTagSingle}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="🌐" VerticalAlignment="Center"/>
              <TextBlock Text="Auto-Tag" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <Button Classes="outline" Click="BulkScrapeQueue_Click" ToolTip.Tip="Bulk Auto-Tag Queue" IsEnabled="{Binding !IsLoading}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="📚" VerticalAlignment="Center"/>
              <TextBlock Text="Bulk Auto-Tag" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <Button Classes="outline" Command="{Binding SyncToKomgaCommand}" ToolTip.Tip="Sync modified metadata &amp; refresh Komga server" IsEnabled="{Binding !IsLoading}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="🌐" VerticalAlignment="Center"/>
              <TextBlock Text="Sync to Komga" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <Button Classes="outline" Command="{Binding RefreshGridCommand}" ToolTip.Tip="Refresh Grid (F5)" IsEnabled="{Binding !IsLoading}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="🔄" VerticalAlignment="Center"/>
              <TextBlock Text="Refresh" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <ToggleButton Classes="outline" IsChecked="{Binding IsRailVisible}" ToolTip.Tip="Toggle Library Rail">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="📁" VerticalAlignment="Center"/>
              <TextBlock Text="Rail" VerticalAlignment="Center"/>
            </StackPanel>
          </ToggleButton>

          <ToggleButton Classes="outline" IsChecked="{Binding IsInspectorVisible}" ToolTip.Tip="Toggle Inspector Panel">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="📋" VerticalAlignment="Center"/>
              <TextBlock Text="Inspector" VerticalAlignment="Center"/>
            </StackPanel>
          </ToggleButton>
        </StackPanel>
      </Grid>
    </Border>

    <!-- View Switcher TabBar -->
    <Border Grid.Row="2" Background="{DynamicResource AppHeaderBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="12,4">
      <Grid ColumnDefinitions="Auto, *, Auto">
        <!-- View selection pills -->
        <Border Grid.Column="0" Background="{DynamicResource AppPillGroupBackgroundBrush}" CornerRadius="6" Padding="2" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <RadioButton Classes="filterPill" GroupName="MainWindowViewModePills" Content="📊 Overview" IsChecked="{Binding IsOverviewView}" Command="{Binding ShowOverviewViewCommand}"/>
            <RadioButton Classes="filterPill" GroupName="MainWindowViewModePills" Content="📑 Library Grid" IsChecked="{Binding IsSpreadsheetView}" Command="{Binding ShowSpreadsheetViewCommand}"/>
          </StackPanel>
        </Border>

        <!-- Current folder breadcrumb -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="16,0" IsVisible="{Binding HasSelectedDirectory}">
          <TextBlock Text="📁" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center" FontSize="11"/>
          <TextBlock Text="{Binding SelectedDirectory}" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Right info indicator -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Background="{DynamicResource AppPillGroupBackgroundBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" IsVisible="{Binding Comics.Count}">
            <TextBlock Text="{Binding FilterStatusText}" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}"/>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Health Dashboard View (Exploration C) -->
    <ScrollViewer Grid.Row="3" IsVisible="{Binding IsOverviewView}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24,18" Spacing="18">

        <!-- Top Header & Status -->
        <Grid ColumnDefinitions="*, Auto">
          <StackPanel Grid.Column="0" Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding SelectedDirectoryFolderName}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
              <Border Background="{DynamicResource AppPillGroupBackgroundBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" IsVisible="{Binding Comics.Count}">
                <TextBlock Text="{Binding AllFilterLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppAccentBrush}"/>
              </Border>
            </StackPanel>
            <TextBlock Text="{Binding FilterStatusText}" FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}"/>
          </StackPanel>

          <!-- Quick switch to grid button -->
          <Button Grid.Column="1" Classes="outline" Command="{Binding ShowSpreadsheetViewCommand}" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="📑" VerticalAlignment="Center"/>
              <TextBlock Text="Open Spreadsheet Grid" VerticalAlignment="Center" FontWeight="Medium"/>
            </StackPanel>
          </Button>
        </Grid>

        <!-- Empty State when no comics loaded -->
        <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="32" IsVisible="{Binding !Comics.Count}">
          <StackPanel Spacing="14" HorizontalAlignment="Center">
            <TextBlock Text="📚" FontSize="36" HorizontalAlignment="Center"/>
            <TextBlock Text="Welcome to InkTag Library Health &amp; Metadata Manager" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="Open a comic folder to diagnose library health, browse series and publishers, and auto-tag metadata." FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}" HorizontalAlignment="Center"/>
            <Button Click="OpenFolder_Click" Background="{DynamicResource AppAccentBrush}" Foreground="{DynamicResource AppAccentForegroundBrush}" Padding="16,8" CornerRadius="4" HorizontalAlignment="Center" Margin="0,8,0,0">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="📁" VerticalAlignment="Center"/>
                <TextBlock Text="Open Comic Folder..." FontWeight="SemiBold" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>

        <!-- Dashboard Content (Visible when comics are loaded) -->
        <StackPanel Spacing="18" IsVisible="{Binding Comics.Count}">

          <!-- Stat Tiles Row (4 Tiles) -->
          <Grid ColumnDefinitions="*, 14, *, 14, *, 14, *">
            <!-- Tile 1: Tagged % -->
            <Button Grid.Column="0" Classes="outline" Command="{Binding SelectSmartListAllCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,14" CornerRadius="8">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding TaggedCount}" FontSize="28" FontWeight="Bold" Foreground="#137333"/>
                <TextBlock Text="Tagged" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                <TextBlock Text="{Binding TaggedPercentage, StringFormat='{}{0}% of library'}" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}"/>
                <ProgressBar Value="{Binding TaggedPercentage}" Minimum="0" Maximum="100" Height="4" Margin="0,6,0,0" Foreground="{DynamicResource AppAccentBrush}"/>
              </StackPanel>
            </Button>

            <!-- Tile 2: Untagged -->
            <Button Grid.Column="2" Classes="outline" Command="{Binding SelectSmartListUntaggedCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,14" CornerRadius="8">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding UntaggedCount}" FontSize="28" FontWeight="Bold" Foreground="#8A5200"/>
                <TextBlock Text="Untagged" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                <TextBlock Text="No ComicInfo.xml metadata" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}"/>
              </StackPanel>
            </Button>

            <!-- Tile 3: Modified / Unsaved -->
            <Button Grid.Column="4" Classes="outline" Command="{Binding SelectSmartListModifiedCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,14" CornerRadius="8">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding ModifiedCount}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"/>
                <TextBlock Text="Modified" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                <TextBlock Text="Pending unsaved edits" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}"/>
              </StackPanel>
            </Button>

            <!-- Tile 4: Read Errors -->
            <Button Grid.Column="6" Classes="outline" Command="{Binding SelectSmartListErrorsCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,14" CornerRadius="8">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding ReadErrorCount}" FontSize="28" FontWeight="Bold" Foreground="#A12A2A"/>
                <TextBlock Text="Read / Parse Errors" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                <TextBlock Text="Corrupted or locked files" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}"/>
              </StackPanel>
            </Button>
          </Grid>

          <!-- Main Content Columns: Left (Needs Attention), Right (Actions & Last Batch) -->
          <Grid ColumnDefinitions="1.35*, 18, 1*">
            <!-- Left: Needs Attention Panel -->
            <Border Grid.Column="0" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
              <Grid RowDefinitions="Auto, Auto, *">
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,12">
                  <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="⚠️ Needs Attention" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                    <Border Background="{DynamicResource AppPillGroupBackgroundBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding NeedsAttentionTotalCount}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    </Border>
                  </StackPanel>
                  <Button Grid.Column="1" Classes="outline" Command="{Binding ViewAllNeedsAttentionCommand}" Padding="8,3" FontSize="11">
                    <TextBlock Text="View in Grid →"/>
                  </Button>
                </Grid>

                <!-- Empty state when no issues -->
                <TextBlock Grid.Row="1" Text="🎉 Great news! All comic files have valid metadata and no errors." 
                           IsVisible="{Binding !NeedsAttentionTotalCount}" Foreground="{DynamicResource AppTextMutedBrush}" Margin="0,20"/>

                <!-- List of items needing attention -->
                <ScrollViewer Grid.Row="2" MaxHeight="380" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding NeedsAttentionItems}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ComicItemViewModel">
                        <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="6,8">
                          <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                            <!-- Icon -->
                            <TextBlock Grid.Column="0" Text="📖" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>

                            <!-- Title and details -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                              <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                              <TextBlock Text="{Binding Series, FallbackValue='Untagged'}" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Status Badge -->
                            <Border Grid.Column="2" CornerRadius="3" Padding="6,2" VerticalAlignment="Center" Margin="8,0"
                                    Background="{DynamicResource AppPillGroupBackgroundBrush}">
                              <TextBlock Text="{Binding StatusBadgeText}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"/>
                            </Border>

                            <!-- Inspect Button -->
                            <Button Grid.Column="3" Classes="outline" Padding="8,4" FontSize="11"
                                    Command="{Binding $parent[Window].DataContext.InspectComicCommand}"
                                    CommandParameter="{Binding}">
                              <TextBlock Text="Inspect →"/>
                            </Button>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </Border>

            <!-- Right: Quick Actions & Last Batch Job -->
            <StackPanel Grid.Column="2" Spacing="16">
              <!-- Quick Actions Panel -->
              <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                  <TextBlock Text="⚡ Quick Actions" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>

                  <!-- Primary Action: Bulk Auto-Tag -->
                  <Button Background="{DynamicResource AppAccentBrush}" Foreground="{DynamicResource AppAccentForegroundBrush}" 
                          HorizontalAlignment="Stretch" Padding="12,10" CornerRadius="6"
                          Command="{Binding TriggerBulkAutoTagCommand}">
                    <Grid ColumnDefinitions="Auto, *">
                      <TextBlock Grid.Column="0" Text="🌐" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding UntaggedCount, StringFormat='Bulk Auto-Tag {0} Untagged'}" FontWeight="Bold" FontSize="12"/>
                        <TextBlock Text="Scrape ComicVine &amp; cover dHash match" FontSize="10" Opacity="0.85"/>
                      </StackPanel>
                    </Grid>
                  </Button>

                  <!-- Action 2: Bulk Rename -->
                  <Button Classes="outline" HorizontalAlignment="Stretch" Padding="12,10" CornerRadius="6"
                          Command="{Binding TriggerBulkRenameCommand}">
                    <Grid ColumnDefinitions="Auto, *">
                      <TextBlock Grid.Column="0" Text="✏️" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="Bulk Rename from Metadata" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Text="Standardize file naming patterns" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}"/>
                      </StackPanel>
                    </Grid>
                  </Button>

                  <!-- Action 3: Komga Sync -->
                  <Button Classes="outline" HorizontalAlignment="Stretch" Padding="12,10" CornerRadius="6"
                          Command="{Binding SyncToKomgaCommand}">
                    <Grid ColumnDefinitions="Auto, *">
                      <TextBlock Grid.Column="0" Text="🔄" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="Sync to Komga Server" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Text="{Binding ModifiedCount, StringFormat='{}{0} modified archive(s)'}" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}"/>
                      </StackPanel>
                    </Grid>
                  </Button>
                </StackPanel>
              </Border>

              <!-- Last Batch Job & Atomic Rollback Panel -->
              <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Grid.Column="0" Text="📦 Last Batch Job" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                    <Button Grid.Column="1" Classes="outline" Padding="8,2" FontSize="10"
                            Command="{Binding RollbackLastBatchCommand}"
                            IsEnabled="{Binding HasLastBatchJob}">
                      <TextBlock Text="Roll Back Batch ↩"/>
                    </Button>
                  </Grid>

                  <TextBlock Text="{Binding LastBatchJobSummaryText}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding LastBatchJobDetailsText}" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding LastBatchJobRollbackStatusText}" FontSize="11" Foreground="{DynamicResource AppAccentBrush}" IsVisible="{Binding LastBatchJobRollbackStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>

        </StackPanel>

      </StackPanel>
    </ScrollViewer>

    <!-- Main Workspace Split Area (Direction A & Spreadsheet Grid) -->
    <Grid Grid.Row="3" x:Name="MainWorkspaceGrid" IsVisible="{Binding IsSpreadsheetView}">
      <Grid.ColumnDefinitions>
        <!-- Column 0: Library Rail -->
        <ColumnDefinition Width="230" MinWidth="180" MaxWidth="350"/>
        <!-- Column 1: GridSplitter between Rail and DataGrid -->
        <ColumnDefinition Width="Auto"/>
        <!-- Column 2: Center Spreadsheet DataGrid -->
        <ColumnDefinition Width="*" MinWidth="400"/>
        <!-- Column 3: GridSplitter between DataGrid and Inspector -->
        <ColumnDefinition Width="Auto"/>
        <!-- Column 4: Inspector Panel -->
        <ColumnDefinition Width="360" MinWidth="320" MaxWidth="750"/>
      </Grid.ColumnDefinitions>

      <!-- Column 0: Library Rail (Direction A) -->
      <Border Grid.Column="0" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0" IsVisible="{Binding IsRailVisible}">
        <Grid RowDefinitions="Auto, Auto, *">
          
          <!-- Rail Header / Title -->
          <Border Grid.Row="0" Padding="14,10,14,6">
            <TextBlock Text="LIBRARY" FontSize="10" FontWeight="Bold" LetterSpacing="0.8" Foreground="{DynamicResource AppTextMutedBrush}"/>
          </Border>

          <!-- Smart Lists Section -->
          <StackPanel Grid.Row="1" Spacing="2" Margin="6,0,6,8">
            <!-- All Comics -->
            <Button Classes="outline" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,6" CornerRadius="4"
                    Command="{Binding SelectSmartListAllCommand}">
              <Grid ColumnDefinitions="Auto, *, Auto">
                <TextBlock Grid.Column="0" Text="📚" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="All Comics" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                <Border Grid.Column="2" Background="{DynamicResource AppPillGroupBackgroundBrush}" CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Comics.Count}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AppTextMutedBrush}"/>
                </Border>
              </Grid>
            </Button>

            <!-- Untagged -->
            <Button Classes="outline" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,6" CornerRadius="4"
                    Command="{Binding SelectSmartListUntaggedCommand}">
              <Grid ColumnDefinitions="Auto, *, Auto">
                <TextBlock Grid.Column="0" Text="🏷️" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Untagged" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                <Border Grid.Column="2" Background="{DynamicResource AppPillGroupBackgroundBrush}" CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding UntaggedCount}" FontSize="10" FontWeight="SemiBold" Foreground="#8A5200"/>
                </Border>
              </Grid>
            </Button>

            <!-- Modified -->
            <Button Classes="outline" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,6" CornerRadius="4"
                    Command="{Binding SelectSmartListModifiedCommand}">
              <Grid ColumnDefinitions="Auto, *, Auto">
                <TextBlock Grid.Column="0" Text="💾" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Modified" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                <Border Grid.Column="2" Background="{DynamicResource AppPillGroupBackgroundBrush}" CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding ModifiedCount}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AppAccentBrush}"/>
                </Border>
              </Grid>
            </Button>

            <!-- Read Errors -->
            <Button Classes="outline" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,6" CornerRadius="4"
                    Command="{Binding SelectSmartListErrorsCommand}">
              <Grid ColumnDefinitions="Auto, *, Auto">
                <TextBlock Grid.Column="0" Text="⚠️" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Read Errors" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                <Border Grid.Column="2" Background="{DynamicResource AppPillGroupBackgroundBrush}" CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding ReadErrorCount}" FontSize="10" FontWeight="SemiBold" Foreground="#A12A2A"/>
                </Border>
              </Grid>
            </Button>
          </StackPanel>

          <!-- Browse Tree / Groups Section -->
          <Grid Grid.Row="2" RowDefinitions="Auto, *">
            <Border Grid.Row="0" Padding="14,10,14,6">
              <TextBlock Text="BROWSE" FontSize="10" FontWeight="Bold" LetterSpacing="0.8" Foreground="{DynamicResource AppTextMutedBrush}"/>
            </Border>

            <TabControl Grid.Row="1" Padding="0">
              <!-- Series Tab -->
              <TabItem Header="Series" FontSize="11">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding SeriesGroups}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:NavRailGroupViewModel">
                        <Button Classes="outline" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,4" Margin="4,1" CornerRadius="3"
                                Command="{Binding $parent[Window].DataContext.FilterBySeriesCommand}"
                                CommandParameter="{Binding Key}">
                          <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Count}" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </TabItem>

              <!-- Publisher Tab -->
              <TabItem Header="Publisher" FontSize="11">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding PublisherGroups}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:NavRailGroupViewModel">
                        <Button Classes="outline" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,4" Margin="4,1" CornerRadius="3"
                                Command="{Binding $parent[Window].DataContext.FilterByPublisherCommand}"
                                CommandParameter="{Binding Key}">
                          <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Count}" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </TabItem>
            </TabControl>
          </Grid>

        </Grid>
      </Border>

      <!-- Column 1: Splitter between Rail and DataGrid -->
      <GridSplitter Grid.Column="1" 
                    Width="6" 
                    Background="{DynamicResource AppBorderBrush}" 
                    ResizeDirection="Columns" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Stretch"
                    IsVisible="{Binding IsRailVisible}" 
                    Focusable="False" 
                    ToolTip.Tip="Drag to resize Library Rail"/>

      <!-- Column 2: Center Spreadsheet DataGrid -->
      <Grid Grid.Column="2" Margin="10" RowDefinitions="Auto, Auto, *">

        <!-- Active Rail Filter Breadcrumb Banner -->
        <Border Grid.Row="0" Background="{DynamicResource AppPillGroupBackgroundBrush}" CornerRadius="4" Padding="8,4" Margin="0,0,0,6" IsVisible="{Binding HasActiveRailFilter}">
          <Grid ColumnDefinitions="*, Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="🔍 Filter:" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding ActiveRailFilterDescription}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AppAccentBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Grid.Column="1" Classes="outline" Command="{Binding ClearRailFilterCommand}" Padding="6,1" FontSize="10" VerticalAlignment="Center">
              <TextBlock Text="✕ Clear"/>
            </Button>
          </Grid>
        </Border>
        
        <!-- Filter & Search Toolbar -->
        <Border Grid.Row="1" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1,1,1,0" CornerRadius="4,4,0,0" Padding="8,6">
          <Grid ColumnDefinitions="Auto, *, Auto">
            <!-- Segmented Filter Pills Group -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="Filter:" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center" FontSize="12" Margin="0,0,4,0"/>
              
              <Border Background="{DynamicResource AppPillGroupBackgroundBrush}" CornerRadius="6" Padding="2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <RadioButton Classes="filterPill" GroupName="ComicFilters" Content="{Binding AllFilterLabel}" IsChecked="{Binding IsFilterAll}"/>
                  <RadioButton Classes="filterPill" GroupName="ComicFilters" Content="{Binding UntaggedFilterLabel}" IsChecked="{Binding IsFilterUntagged}"/>
                  <RadioButton Classes="filterPill" GroupName="ComicFilters" Content="{Binding ModifiedFilterLabel}" IsChecked="{Binding IsFilterModified}"/>
                  <RadioButton Classes="filterPill" GroupName="ComicFilters" Content="{Binding ErrorsFilterLabel}" IsChecked="{Binding IsFilterErrors}"/>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- Quick Filter / Search Box -->
            <TextBox Grid.Column="1" Text="{Binding FilterSearchText}" 
                     PlaceholderText="🔍 Filter list by file name, series, title, writer..." 
                     Margin="16,0" Padding="6,4" FontSize="11" Height="26"
                     Background="{DynamicResource AppInputBackgroundBrush}" Foreground="{DynamicResource AppTextPrimaryBrush}" BorderBrush="{DynamicResource AppInputBorderBrush}" CornerRadius="3"/>

            <!-- Status Count Badge -->
            <TextBlock Grid.Column="2" Text="{Binding FilterStatusText}" 
                       Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="4,0,2,0"/>
          </Grid>
        </Border>

        <!-- Comic DataGrid Table -->
        <DataGrid Grid.Row="2" Name="ComicsGrid" ItemsSource="{Binding DisplayedComics}" SelectedItem="{Binding ActiveComic}" 
                  SelectionMode="Extended" CanUserSortColumns="True" CanUserResizeColumns="True"
                  Background="{DynamicResource AppDataGridBackgroundBrush}" AutoGenerateColumns="False" 
                  BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                  GridLinesVisibility="All" HeadersVisibility="Column"
                  SelectionChanged="DataGrid_SelectionChanged">
          <DataGrid.ContextMenu>
            <ContextMenu>
              <MenuItem Header="🔍 Auto-Tag Metadata (ComicVine)..." Click="ScrapeMetadata_Click" IsEnabled="{Binding CanAutoTagSingle}"/>
              <MenuItem Header="🧙 Series Search Wizard..." Click="SeriesSearchWizard_Click" IsEnabled="{Binding CanAutoTagSingle}"/>
              <MenuItem Header="📚 Bulk Auto-Tag Selected..." Click="BulkScrapeQueue_Click"/>
              <Separator/>
              <MenuItem Header="🏷️ Infer Metadata from Path / Filename" Click="InferMetadataFromFilenames_Click"/>
              <MenuItem Header="✏️ Rename File(s) from Metadata..." Click="RenameFiles_Click"/>
              <Separator/>
              <MenuItem Header="🌐 Sync Selected with Komga" Command="{Binding SyncToKomgaCommand}"/>
            </ContextMenu>
          </DataGrid.ContextMenu>
          <DataGrid.Styles>
            <Style Selector="DataGridRow">
              <Setter Property="Background" Value="{Binding IsDirty, Converter={StaticResource IsDirtyToBrushConverter}}" />
            </Style>
          </DataGrid.Styles>
          <DataGrid.Columns>
            <DataGridCheckBoxColumn Header="Untagged" Binding="{Binding IsUntagged}" IsReadOnly="True" Width="95" MinWidth="95"/>
            <DataGridTemplateColumn Header="File Name" Width="240" MinWidth="160" SortMemberPath="FileName">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:ComicItemViewModel">
                  <controls:HuggingBadgePanel Spacing="6" VerticalAlignment="Center" Margin="6,0">
                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding FileName}"/>
                    <Border IsVisible="{Binding IsCbr}"
                            Background="{Binding FormatBadgeBackground}"
                            BorderBrush="{Binding FormatBadgeBorder}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="5,1"
                            VerticalAlignment="Center"
                            ToolTip.Tip="{Binding FormatConversionTooltip}">
                      <TextBlock Text="{Binding FormatBadgeText}"
                                 FontSize="9.5"
                                 FontWeight="SemiBold"
                                 Foreground="{Binding FormatBadgeForeground}"
                                 VerticalAlignment="Center"/>
                    </Border>
                  </controls:HuggingBadgePanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="180" MinWidth="100"/>
            <DataGridTextColumn Header="Series" Binding="{Binding Series}" Width="160" MinWidth="100"/>
            <DataGridTextColumn Header="Issue #" Binding="{Binding Number}" Width="85" MinWidth="85"/>
            <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="75" MinWidth="75"/>
            <DataGridTextColumn Header="Volume" Binding="{Binding Volume}" Width="85" MinWidth="85"/>
            <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="140" MinWidth="100"/>
            <DataGridTextColumn Header="Imprint" Binding="{Binding Imprint}" Width="120" MinWidth="90"/>
            <DataGridTextColumn Header="Series Group" Binding="{Binding SeriesGroup}" Width="140" MinWidth="125"/>
            <DataGridTextColumn Header="Story Arc" Binding="{Binding StoryArc}" Width="140" MinWidth="100"/>
            <DataGridTextColumn Header="Year" Binding="{Binding Year}" Width="75" MinWidth="75"/>
            <DataGridTextColumn Header="Month" Binding="{Binding Month}" Width="80" MinWidth="80"/>
            <DataGridTextColumn Header="Day" Binding="{Binding Day}" Width="75" MinWidth="75"/>
            <DataGridTextColumn Header="Genre" Binding="{Binding Genre}" Width="120" MinWidth="85"/>
            <DataGridTextColumn Header="Tags" Binding="{Binding Tags}" Width="140" MinWidth="80"/>
            <DataGridTextColumn Header="Writer" Binding="{Binding Writer}" Width="140" MinWidth="85"/>
            <DataGridTextColumn Header="Penciller" Binding="{Binding Penciller}" Width="140" MinWidth="95"/>
            <DataGridTextColumn Header="Inker" Binding="{Binding Inker}" Width="140" MinWidth="80"/>
            <DataGridTextColumn Header="Colorist" Binding="{Binding Colorist}" Width="140" MinWidth="90"/>
            <DataGridTextColumn Header="Letterer" Binding="{Binding Letterer}" Width="140" MinWidth="90"/>
            <DataGridTextColumn Header="Cover Artist" Binding="{Binding CoverArtist}" Width="140" MinWidth="120"/>
            <DataGridTextColumn Header="Editor" Binding="{Binding Editor}" Width="140" MinWidth="80"/>
            <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="220" MinWidth="100"/>
            <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="180" MinWidth="80"/>
            <DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="100" MinWidth="85"/>
            <DataGridTextColumn Header="Black &amp; White" Binding="{Binding BlackAndWhite}" Width="135" MinWidth="135"/>
            <DataGridTextColumn Header="Age Rating" Binding="{Binding AgeRating}" Width="115" MinWidth="115"/>
            <DataGridTextColumn Header="Language ISO" Binding="{Binding LanguageISO}" Width="125" MinWidth="125"/>
            <DataGridTextColumn Header="Page Count" Binding="{Binding PageCount}" Width="110" MinWidth="110"/>
            <DataGridTextColumn Header="Characters" Binding="{Binding Characters}" Width="160" MinWidth="105"/>
            <DataGridTextColumn Header="Teams" Binding="{Binding Teams}" Width="140" MinWidth="85"/>
            <DataGridTextColumn Header="Locations" Binding="{Binding Locations}" Width="140" MinWidth="95"/>
            <DataGridTextColumn Header="Scan Info" Binding="{Binding ScanInformation}" Width="160" MinWidth="100"/>
            <DataGridTextColumn Header="Web Link" Binding="{Binding Web}" Width="180" MinWidth="100"/>
            <DataGridCheckBoxColumn Header="Manga (RTL)" Binding="{Binding Manga}" Width="115" MinWidth="115"/>
          </DataGrid.Columns>
        </DataGrid>

        <!-- Loading & Progress Overlay (Centered specifically over the DataGrid panel) -->
        <Border Grid.Row="2" IsVisible="{Binding IsLoading}" Background="{DynamicResource AppOverlayBackdropBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
          <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="1" CornerRadius="8" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" BoxShadow="0 4 16 #80000000">
            <StackPanel Spacing="14" HorizontalAlignment="Center">
              <ProgressBar Value="{Binding ProgressValue}" Minimum="0" Maximum="100" Height="6" Width="300" Foreground="{DynamicResource AppAccentBrush}"/>
              <TextBlock Text="{Binding ProgressText}" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460"/>

              <!-- Slow Network Share Warning Card -->
              <Border IsVisible="{Binding IsSlowShareWarningVisible}" Background="#3A2A18" BorderBrush="#E5A00D" BorderThickness="1" CornerRadius="6" Padding="10">
                <StackPanel Spacing="5">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="⚠️" FontSize="13"/>
                    <TextBlock Text="Slow Virtual Share Detected" FontWeight="Bold" Foreground="#FFD54F" FontSize="12"/>
                  </StackPanel>
                  <TextBlock Text="This remote mount does not support archive seeking and requires streaming complete files over the network. For instant performance, mount via SMB/CIFS."
                             FontSize="11" Foreground="#DDD" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>

              <Button Content="✕ Cancel Scan" Command="{Binding CancelScanCommand}"
                      Background="#C42B1C" Foreground="White" FontWeight="SemiBold" Padding="16,6" HorizontalAlignment="Center" CornerRadius="4"/>
            </StackPanel>
          </Border>
        </Border>
      </Grid>

      <!-- Splitter Column: GridSplitter between DataGrid and Inspector -->
      <GridSplitter Grid.Column="3" 
                    Width="6" 
                    Background="{DynamicResource AppBorderBrush}" 
                    ResizeDirection="Columns" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Stretch"
                    IsVisible="{Binding IsInspectorVisible}" 
                    Focusable="False" 
                    ToolTip.Tip="Drag to resize Inspector panel"/>

      <!-- Right Column: Details & Bulk Tools Sidebar -->
      <Border Grid.Column="4" MinWidth="320" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1,0,0,0" Padding="15,15,10,15" IsVisible="{Binding IsInspectorVisible}">
        <TabControl Theme="{StaticResource {x:Type TabControl}}">
          
          <!-- Tab 1: Single Comic Inspector -->
          <TabItem Header="Details" FontSize="13">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0" Padding="0,0,12,0">
              <StackPanel Spacing="12">
                <Border Background="{DynamicResource AppInputBackgroundBrush}" CornerRadius="4" Padding="5" HorizontalAlignment="Center" Height="200" Width="150">
                  <Panel>
                    <TextBlock Text="No Cover" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppTextMutedBrush}" IsVisible="{Binding ActiveComic.CoverImage, Converter={x:Static ObjectConverters.IsNull}}"/>
                    <Image Source="{Binding ActiveComic.CoverImage}" Stretch="Uniform" IsVisible="{Binding ActiveComic.CoverImage, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                  </Panel>
                </Border>

                <StackPanel Spacing="5" IsVisible="{Binding ActiveComic, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <TextBlock Text="File Name" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11"/>
                  <TextBox Text="{Binding ActiveComic.FileName}" IsReadOnly="True" Background="{DynamicResource AppInputBackgroundBrush}" BorderThickness="1"/>
                  
                  <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,2" IsVisible="{Binding ActiveComic.IsCbr}">
                    <Border Background="{Binding ActiveComic.FormatBadgeBackground}"
                            BorderBrush="{Binding ActiveComic.FormatBadgeBorder}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="5,1"
                            VerticalAlignment="Center"
                            ToolTip.Tip="{Binding ActiveComic.FormatConversionTooltip}">
                      <TextBlock Text="{Binding ActiveComic.FormatBadgeText}"
                                 FontSize="10"
                                 FontWeight="SemiBold"
                                 Foreground="{Binding ActiveComic.FormatBadgeForeground}"/>
                    </Border>
                    <TextBlock Text="Converts to .cbz on save"
                               Foreground="{DynamicResource AppTextMutedBrush}"
                               FontSize="11"
                               VerticalAlignment="Center"/>
                  </StackPanel>
                  
                  <TextBlock Text="Title" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                  <TextBox Text="{Binding ActiveComic.Title}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                  <TextBlock Text="Series" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                  <TextBox Text="{Binding ActiveComic.Series}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                  <Grid ColumnDefinitions="*, *" Margin="0,5,0,0" KeyboardNavigation.TabNavigation="Continue">
                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                      <TextBlock Text="Issue (Number)" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11"/>
                      <TextBox Text="{Binding ActiveComic.Number}" Background="{DynamicResource AppInputBackgroundBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                      <TextBlock Text="Volume" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11"/>
                      <TextBox Text="{Binding ActiveComic.Volume}" Background="{DynamicResource AppInputBackgroundBrush}"/>
                    </StackPanel>
                  </Grid>

                  <TextBlock Text="Publisher" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                  <TextBox Text="{Binding ActiveComic.Publisher}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                  <Grid ColumnDefinitions="*, *" Margin="0,5,0,0" KeyboardNavigation.TabNavigation="Continue">
                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                      <TextBlock Text="Year" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11"/>
                      <TextBox Text="{Binding ActiveComic.Year}" Background="{DynamicResource AppInputBackgroundBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                      <TextBlock Text="Month" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11"/>
                      <TextBox Text="{Binding ActiveComic.Month}" Background="{DynamicResource AppInputBackgroundBrush}"/>
                    </StackPanel>
                  </Grid>

                  <TextBlock Text="Writer" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                  <TextBox Text="{Binding ActiveComic.Writer}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                  <TextBlock Text="Genre" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                  <TextBox Text="{Binding ActiveComic.Genre}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                  <TextBlock Text="Tags (Comma separated)" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                  <TextBox Text="{Binding ActiveComic.Tags}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                  <TextBlock Text="Language ISO" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                  <TextBox Text="{Binding ActiveComic.LanguageISO}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                  <CheckBox Content="Manga (Read Right-to-Left)" IsChecked="{Binding ActiveComic.Manga}" Margin="0,8,0,0"/>
                </StackPanel>
                <TextBlock Text="Select a comic to view details" Foreground="{DynamicResource AppTextMutedBrush}" HorizontalAlignment="Center" Margin="0,50,0,0" IsVisible="{Binding ActiveComic, Converter={x:Static ObjectConverters.IsNull}}"/>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          
          <!-- Tab 2: Bulk Apply Tools -->
          <TabItem Header="Bulk Edit" FontSize="13">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0" Padding="0,0,12,0">
              <StackPanel Spacing="12">
                <TextBlock Text="Modify selected rows in batch:" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,0,0,5"/>

                <ItemsControl ItemsSource="{Binding BulkEditRules}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BulkEditRuleViewModel">
                      <Border Background="{DynamicResource AppCardBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                        <StackPanel Spacing="6">
                          <!-- Row Header: Field & Operation -->
                          <Grid ColumnDefinitions="*, *, Auto">
                            <ComboBox ItemsSource="{Binding AvailableFields}" SelectedItem="{Binding SelectedField}" Grid.Column="0" Margin="0,0,4,0" HorizontalAlignment="Stretch">
                              <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:BulkEditFieldInfo">
                                  <TextBlock Text="{Binding DisplayName}"/>
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ComboBox ItemsSource="{Binding AvailableOperations}" SelectedItem="{Binding SelectedOperation}" Grid.Column="1" Margin="4,0,4,0" HorizontalAlignment="Stretch"/>
                            <Button Content="✕" Command="{Binding $parent[Window].DataContext.RemoveBulkRuleCommand}" CommandParameter="{Binding .}" Grid.Column="2" Padding="6,2" Background="{DynamicResource AppButtonBackgroundBrush}" Foreground="{DynamicResource AppTextPrimaryBrush}" ToolTip.Tip="Remove Rule"/>
                          </Grid>

                          <!-- Context-Sensitive Inputs -->
                          <!-- String Text Editor -->
                          <TextBox Text="{Binding StringValue}" PlaceholderText="New Value" IsVisible="{Binding IsTextEditorVisible}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                          <!-- Numeric Editor -->
                          <NumericUpDown Value="{Binding NumericValue}" IsVisible="{Binding IsNumericEditorVisible}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                          <!-- Enum Selector -->
                          <ComboBox ItemsSource="{Binding EnumOptions}" SelectedItem="{Binding SelectedEnumOption}" IsVisible="{Binding IsEnumEditorVisible}" HorizontalAlignment="Stretch" Background="{DynamicResource AppInputBackgroundBrush}"/>

                          <!-- Find & Replace Pair -->
                          <Grid ColumnDefinitions="*, *" IsVisible="{Binding IsReplaceEditorVisible}">
                            <TextBox Text="{Binding FindValue}" PlaceholderText="Find..." Grid.Column="0" Margin="0,0,4,0" Background="{DynamicResource AppInputBackgroundBrush}"/>
                            <TextBox Text="{Binding ReplaceValue}" PlaceholderText="Replace with..." Grid.Column="1" Margin="4,0,0,0" Background="{DynamicResource AppInputBackgroundBrush}"/>
                          </Grid>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid ColumnDefinitions="*, Auto" Margin="0,4,0,4">
                  <StackPanel Orientation="Horizontal" Spacing="8" Grid.Column="0">
                    <Button Content="+ Add Rule" Command="{Binding AddBulkRuleCommand}" Padding="10,6" Background="{DynamicResource AppButtonBackgroundBrush}" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                    <Button Content="Clear" Command="{Binding ClearBulkRulesCommand}" Padding="10,6" Background="{DynamicResource AppButtonBackgroundBrush}" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                  </StackPanel>
                  <Button Content="Apply Rules" Command="{Binding ApplyBulkRulesCommand}" Grid.Column="1" Padding="14,6" FontWeight="SemiBold" Background="{DynamicResource AppAccentBrush}" Foreground="{DynamicResource AppAccentForegroundBrush}"/>
                </Grid>

                <TextBlock Text="Tip: Applies all rules above to selected rows (or all visible rows if none are selected)." Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" TextWrapping="Wrap"/>

                <Separator Background="{DynamicResource AppBorderBrush}" Margin="0,4"/>

                <!-- Core Details Group -->
                <TextBlock Text="Core Information" FontWeight="SemiBold" Foreground="#4EC9B0" FontSize="12"/>
                <TextBlock Text="Title" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11"/>
                <TextBox Text="{Binding ActiveComic.Title}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <TextBlock Text="Series" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                <TextBox Text="{Binding ActiveComic.Series}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <Grid ColumnDefinitions="*, *, *">
                  <StackPanel Grid.Column="0" Margin="0,0,4,0">
                    <TextBlock Text="Issue #" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11"/>
                    <TextBox Text="{Binding ActiveComic.Number}" Background="{DynamicResource AppInputBackgroundBrush}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="2,0,2,0">
                    <TextBlock Text="Count" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11"/>
                    <TextBox Text="{Binding ActiveComic.Count}" Background="{DynamicResource AppInputBackgroundBrush}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Margin="4,0,0,0">
                    <TextBlock Text="Volume" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11"/>
                    <TextBox Text="{Binding ActiveComic.Volume}" Background="{DynamicResource AppInputBackgroundBrush}"/>
                  </StackPanel>
                </Grid>

                <TextBlock Text="Publisher" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                <TextBox Text="{Binding ActiveComic.Publisher}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <TextBlock Text="Imprint" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                <TextBox Text="{Binding ActiveComic.Imprint}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <TextBlock Text="Series Group" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                <TextBox Text="{Binding ActiveComic.SeriesGroup}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <TextBlock Text="Story Arc" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                <TextBox Text="{Binding ActiveComic.StoryArc}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <Grid ColumnDefinitions="*, *, *" Margin="0,5,0,0">
                  <StackPanel Grid.Column="0" Margin="0,0,4,0">
                    <TextBlock Text="Year" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11"/>
                    <TextBox Text="{Binding ActiveComic.Year}" Background="{DynamicResource AppInputBackgroundBrush}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="2,0,2,0">
                    <TextBlock Text="Month" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11"/>
                    <TextBox Text="{Binding ActiveComic.Month}" Background="{DynamicResource AppInputBackgroundBrush}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Margin="4,0,0,0">
                    <TextBlock Text="Day" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11"/>
                    <TextBox Text="{Binding ActiveComic.Day}" Background="{DynamicResource AppInputBackgroundBrush}"/>
                  </StackPanel>
                </Grid>

                <!-- Creators Group -->
                <TextBlock Text="Creators" FontWeight="SemiBold" Foreground="#4EC9B0" FontSize="12" Margin="0,10,0,0"/>
                
                <TextBlock Text="Writer" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11"/>
                <TextBox Text="{Binding ActiveComic.Writer}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <TextBlock Text="Penciller" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                <TextBox Text="{Binding ActiveComic.Penciller}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <TextBlock Text="Inker" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                <TextBox Text="{Binding ActiveComic.Inker}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <TextBlock Text="Colorist" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                <TextBox Text="{Binding ActiveComic.Colorist}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <TextBlock Text="Letterer" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                <TextBox Text="{Binding ActiveComic.Letterer}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <TextBlock Text="Cover Artist" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                <TextBox Text="{Binding ActiveComic.CoverArtist}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <TextBlock Text="Editor" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                <TextBox Text="{Binding ActiveComic.Editor}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <!-- Content & Classification -->
                <TextBlock Text="Content &amp; Classification" FontWeight="SemiBold" Foreground="#4EC9B0" FontSize="12" Margin="0,10,0,0"/>

                <TextBlock Text="Summary" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11"/>
                <TextBox Text="{Binding ActiveComic.Summary}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <TextBlock Text="Genre" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                <TextBox Text="{Binding ActiveComic.Genre}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <TextBlock Text="Tags" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                <TextBox Text="{Binding ActiveComic.Tags}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <TextBlock Text="Notes" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                <TextBox Text="{Binding ActiveComic.Notes}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <Grid ColumnDefinitions="*, *">
                  <StackPanel Grid.Column="0" Margin="0,0,4,0">
                    <TextBlock Text="Format" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11"/>
                    <TextBox Text="{Binding ActiveComic.Format}" Background="{DynamicResource AppInputBackgroundBrush}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="4,0,0,0">
                    <TextBlock Text="Age Rating" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11"/>
                    <TextBox Text="{Binding ActiveComic.AgeRating}" Background="{DynamicResource AppInputBackgroundBrush}"/>
                  </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="*, *">
                  <StackPanel Grid.Column="0" Margin="0,0,4,0">
                    <TextBlock Text="Language ISO" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11"/>
                    <TextBox Text="{Binding ActiveComic.LanguageISO}" Background="{DynamicResource AppInputBackgroundBrush}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="4,0,0,0">
                    <TextBlock Text="Page Count" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11"/>
                    <TextBox Text="{Binding ActiveComic.PageCount}" Background="{DynamicResource AppInputBackgroundBrush}"/>
                  </StackPanel>
                </Grid>

                <TextBlock Text="Characters" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                <TextBox Text="{Binding ActiveComic.Characters}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <TextBlock Text="Teams" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                <TextBox Text="{Binding ActiveComic.Teams}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <TextBlock Text="Locations" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                <TextBox Text="{Binding ActiveComic.Locations}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <TextBlock Text="Scan Info" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                <TextBox Text="{Binding ActiveComic.ScanInformation}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <TextBlock Text="Web Link" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                <TextBox Text="{Binding ActiveComic.Web}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <CheckBox IsChecked="{Binding ActiveComic.BlackAndWhite}" Content="Black &amp; White" Margin="0,5,0,0"/>
                <CheckBox IsChecked="{Binding ActiveComic.Manga}" Content="Manga (Right-to-Left)" Margin="0,2,0,10"/>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <!-- Tab 3: Multi-Item Bulk Tools -->
          <TabItem Header="Bulk Tools" FontSize="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0" Padding="0,0,12,0">
              <StackPanel Spacing="8" Margin="0,0,0,10">
                <TextBlock Text="Bulk Edit Controls" FontWeight="Bold" FontSize="14" Foreground="#3592FF" Margin="0,0,0,5"/>

                <CheckBox IsChecked="{Binding BulkSeriesEnabled}" Content="Set Series"/>
                <TextBox Text="{Binding BulkSeries}" IsEnabled="{Binding BulkSeriesEnabled}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <CheckBox IsChecked="{Binding BulkPublisherEnabled}" Content="Set Publisher" Margin="0,5,0,0"/>
                <TextBox Text="{Binding BulkPublisher}" IsEnabled="{Binding BulkPublisherEnabled}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <CheckBox IsChecked="{Binding BulkYearEnabled}" Content="Set Year" Margin="0,5,0,0"/>
                <TextBox Text="{Binding BulkYear}" IsEnabled="{Binding BulkYearEnabled}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <CheckBox IsChecked="{Binding BulkGenreEnabled}" Content="Set Genre" Margin="0,5,0,0"/>
                <TextBox Text="{Binding BulkGenre}" IsEnabled="{Binding BulkGenreEnabled}" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <CheckBox IsChecked="{Binding BulkMangaEnabled}" Content="Set Manga Direction" Margin="0,5,0,0"/>
                <ComboBox ItemsSource="{Binding MangaOptions}" SelectedItem="{Binding BulkManga}" IsEnabled="{Binding BulkMangaEnabled}" HorizontalAlignment="Stretch" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <Button Content="Apply to Selected / All" Command="{Binding BulkApplyCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,15,0,0" Padding="10" Background="{DynamicResource AppAccentBrush}" Foreground="{DynamicResource AppAccentForegroundBrush}"/>
                <TextBlock Text="Tip: Applies only to selected rows, or all rows if none are highlighted." Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>

                <Separator Background="{DynamicResource AppBorderBrush}" Margin="0,10"/>

                <TextBlock Text="Find &amp; Replace" FontWeight="Bold" FontSize="14" Foreground="#3592FF"/>

                <TextBlock Text="Target Column" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11"/>
                <ComboBox ItemsSource="{Binding ReplaceColumns}" SelectedItem="{Binding SelectedReplaceColumn}" HorizontalAlignment="Stretch" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <TextBlock Text="Find text" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                <TextBox Text="{Binding FindText}" Watermark="e.g. Vol 1" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <TextBlock Text="Replace with" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                <TextBox Text="{Binding ReplaceText}" Watermark="e.g. Volume 1" Background="{DynamicResource AppInputBackgroundBrush}"/>

                <Button Content="Execute Replace" Command="{Binding FindReplaceCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,15,0,0" Padding="10" Background="#0E639C" Foreground="White"/>
                <TextBlock Text="Tip: Applies only to selected rows, or all rows if none are highlighted." Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          
        </TabControl>
      </Border>
    </Grid>

    <!-- Bottom Soft Framed Status Bar -->
    <Border Grid.Row="4" Background="{DynamicResource AppStatusBarBackgroundBrush}" BorderBrush="{DynamicResource AppStatusBarBorderBrush}" BorderThickness="0,1,0,0" Padding="12,5">
      <Grid ColumnDefinitions="Auto, Auto, *, Auto">
        <!-- Loaded File Count & Active Folder Breadcrumb -->
        <StackPanel Orientation="Horizontal" Spacing="8" Grid.Column="0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Comics.Count, StringFormat='{}{0} files loaded'}" Foreground="{DynamicResource AppStatusBarForegroundBrush}" FontSize="12" FontWeight="SemiBold"/>

          <TextBlock Text="•" Foreground="{DynamicResource AppStatusBarMutedBrush}" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding HasSelectedDirectory}"/>
          <TextBlock Text="{Binding SelectedDirectory, StringFormat='📁 {0}'}" TextTrimming="CharacterEllipsis" MaxWidth="420"
                     Foreground="{DynamicResource AppStatusBarMutedBrush}" VerticalAlignment="Center" FontSize="11" ToolTip.Tip="{Binding SelectedDirectory}"
                     IsVisible="{Binding HasSelectedDirectory}"/>
        </StackPanel>

        <!-- Progress Tracker in Status Bar -->
        <StackPanel Orientation="Horizontal" Spacing="10" Grid.Column="1" VerticalAlignment="Center" Margin="15,0,0,0">
          <Rectangle Width="1" Fill="{DynamicResource AppStatusBarBorderBrush}" Height="12" VerticalAlignment="Center"/>
          
          <!-- Animated Progress Bar -->
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressValue}" Width="120" Height="6" CornerRadius="3"
                       IsVisible="{Binding IsLoading}" VerticalAlignment="Center"
                       Background="{DynamicResource AppBorderBrush}" Foreground="{DynamicResource AppAccentBrush}"/>
          
          <TextBlock Text="{Binding ProgressText}" Foreground="{DynamicResource AppStatusBarMutedBrush}" VerticalAlignment="Center" FontSize="11"/>

          <!-- Cancel Scan Button -->
          <Button Classes="outline" Command="{Binding CancelScanCommand}" Content="✕ Cancel" IsVisible="{Binding IsLoading}"
                  Padding="6,2" FontSize="11" CornerRadius="3"
                  VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Update Status Text -->
        <TextBlock Grid.Column="2" Text="{Binding UpdateStatusText}" Foreground="{DynamicResource AppStatusBarMutedBrush}" VerticalAlignment="Center" FontSize="11" HorizontalAlignment="Right" Margin="0,0,15,0"/>

        <!-- Version Label -->
        <StackPanel Orientation="Horizontal" Spacing="10" Grid.Column="3" VerticalAlignment="Center">
          <TextBlock Text="{Binding AppVersionText}" Foreground="{DynamicResource AppStatusBarMutedBrush}" FontSize="11" VerticalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </Border>

  </Grid>
</Window>
